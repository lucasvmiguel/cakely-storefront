# Supply-chain cooldown: npm will not resolve any package version published
# less than 7 days ago (needs npm >= 11.10). Malicious releases are usually
# caught and unpublished within days, so this keeps them out of
# package-lock.json. CI enforces the same rule on the lockfile itself via
# scripts/check-package-age.mjs, so it can't be bypassed by an older npm,
# --min-release-age=0, or a hand-edited lockfile.
min-release-age=7
